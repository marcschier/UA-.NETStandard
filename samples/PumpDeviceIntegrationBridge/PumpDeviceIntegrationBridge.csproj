<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>PumpDeviceIntegrationBridge</AssemblyName>
    <PackageId>PumpDeviceIntegrationBridge</PackageId>
    <PackageReadmeFile>NugetREADME.md</PackageReadmeFile>
    <Description>Standalone OPC UA client that bridges a server's OPC UA - OpenUSD Bindings model to a live USD override layer. Discovers Server/OpenUSD/Representations, subscribes to the bound Variables, converts, and authors live.usda. This is the "connector" actor of the OpenUSD Bindings companion spec.</Description>
    <RootNamespace>PumpDeviceIntegrationBridge</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="NugetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Opc.Ua.Client\Opc.Ua.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
