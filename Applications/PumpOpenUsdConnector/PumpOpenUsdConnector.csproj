<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AppTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>PumpOpenUsdConnector</AssemblyName>
    <PackageId>PumpOpenUsdConnector</PackageId>
    <Description>Standalone OPC UA client that bridges a server's OPC UA - OpenUSD Bindings model to a live USD override layer. Discovers Server/OpenUSD/Representations, subscribes to the bound Variables, converts, and authors live.usda. This is the "connector" actor of the OpenUSD Bindings companion spec.</Description>
    <RootNamespace>PumpOpenUsdConnector</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Opc.Ua.Configuration\Opc.Ua.Configuration.csproj" />
    <ProjectReference Include="..\..\Libraries\Opc.Ua.Client\Opc.Ua.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
